generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model users {
  id              Int               @id @default(autoincrement())
  full_name       String?           @db.VarChar(100)
  email           String?           @db.VarChar(100)
  phone           String?           @db.VarChar(20)
  role            users_role
  status          users_status?     @default(active)
  lang            String?           @default("vi") @db.VarChar(10)
  created_at      DateTime          @default(now()) @db.Timestamp(0)
  updated_at      DateTime          @default(now()) @db.Timestamp(0)
  avatar_path     String?           @db.VarChar(255)
  user_code       String?           @db.VarChar(50)
  address         String?           @db.VarChar(255)
  accounts        accounts?
  borrow_records  borrow_records[]
  purchase_orders purchase_orders[]
}

model authors {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(100)
  bio          String?        @db.Text
  book_authors book_authors[]
}

model book_authors {
  book_id   Int
  author_id Int
  books     books   @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "book_authors_ibfk_1")
  authors   authors @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "book_authors_ibfk_2")

  @@id([book_id, author_id])
  @@index([author_id], map: "author_id")
}

model books {
  id                   Int                    @id @default(autoincrement())
  isbn                 String?                @unique(map: "isbn") @db.VarChar(20)
  title                String                 @db.VarChar(255)
  description          String?                @db.Text
  publish_year         Int?
  language             String?                @db.VarChar(50)
  pages                Int?
  publisher_id         Int?
  category_id          Int?
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  stock_quantity       Int                    @default(0)
  borrowed_quantity    Int                    @default(0)
  reserved_quantity    Int                    @default(0)
  available_quantity   Int                    @default(0)
  avatar_path          String?                @db.VarChar(255)
  price                Decimal                @default(0.00) @db.Decimal(10, 2)
  content              String?                @db.LongText
  book_authors         book_authors[]
  publishers           publishers?            @relation(fields: [publisher_id], references: [id], onUpdate: Restrict, map: "books_ibfk_1")
  categories           categories?            @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "books_ibfk_2")
  borrow_details       borrow_details[]
  purchase_order_items purchase_order_items[]

  @@index([category_id], map: "category_id")
  @@index([publisher_id], map: "publisher_id")
}

model borrow_details {
  borrow_id      Int
  book_id        Int
  borrow_records borrow_records @relation(fields: [borrow_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "borrow_details_ibfk_1")
  books          books          @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "borrow_details_ibfk_2")

  @@id([borrow_id, book_id])
  @@index([book_id], map: "book_id")
}

model borrow_records {
  id             Int                    @id @default(autoincrement())
  borrow_date    DateTime               @db.Date
  due_date       DateTime               @db.Date
  return_date    DateTime?              @db.Date
  status         borrow_records_status? @default(borrowing)
  borrow_code    String                 @db.Char(20)
  user_id        Int?
  borrow_details borrow_details[]
  users          users?                 @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_borrow_records_user")
  fines          fines[]

  @@index([user_id], map: "fk_borrow_records_user")
}

model publishers {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(150)
  address String? @db.VarChar(255)
  phone   String? @db.Char(20)
  email   String  @db.Char(50)
  books   books[]
}

model readers {
  id            Int             @id @default(autoincrement())
  reader_code   String          @unique(map: "reader_code") @db.VarChar(20)
  full_name     String          @db.VarChar(100)
  date_of_birth DateTime?       @db.Date
  gender        readers_gender?
  email         String?         @db.VarChar(100)
  phone         String?         @db.VarChar(20)
  address       String?         @db.VarChar(255)
  created_at    DateTime        @default(now()) @db.Timestamp(0)
}

model accounts {
  id              Int       @id @default(autoincrement())
  user_id         Int       @unique(map: "user_id")
  username        String    @unique(map: "username") @db.VarChar(50)
  password        String    @db.VarChar(255)
  failed_attempts Int?      @default(0)
  locked_until    DateTime? @db.DateTime(0)
  created_at      DateTime  @default(now()) @db.Timestamp(0)
  updated_at      DateTime  @default(now()) @db.Timestamp(0)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_accounts_user")
}

model categories {
  id               Int          @id @default(autoincrement())
  name             String       @db.VarChar(100)
  parent_id        Int?
  books            books[]
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: Restrict, map: "categories_ibfk_1")
  other_categories categories[] @relation("categoriesTocategories")

  @@index([parent_id], map: "parent_id")
}

model fines {
  id             Int            @id @default(autoincrement())
  borrow_id      Int
  amount         Decimal        @db.Decimal(10, 2)
  reason         String?        @db.VarChar(255)
  paid           Boolean?       @default(false)
  borrow_records borrow_records @relation(fields: [borrow_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fines_ibfk_1")

  @@index([borrow_id], map: "borrow_id")
}

model bank_accounts {
  id             Int      @id @default(autoincrement())
  bank_name      String   @db.VarChar(255)
  bank_code      String   @db.VarChar(50)
  account_number String   @db.VarChar(50)
  created_at     DateTime @default(now()) @db.Timestamp(0)
  is_default     Int
  owner_name     String   @db.VarChar(50)
}

model purchase_order_items {
  id                Int             @id @default(autoincrement())
  purchase_order_id Int
  book_id           Int
  quantity          Int             @default(1)
  unit_price        Decimal         @db.Decimal(10, 2)
  created_at        DateTime        @default(now()) @db.Timestamp(0)
  books             books           @relation(fields: [book_id], references: [id], onUpdate: Restrict, map: "fk_purchase_order_items_book")
  purchase_orders   purchase_orders @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_purchase_order_items_order")

  @@index([book_id], map: "fk_purchase_order_items_book")
  @@index([purchase_order_id], map: "fk_purchase_order_items_order")
}

model purchase_orders {
  id                   Int                    @id @default(autoincrement())
  guest_name           String?                @db.VarChar(255)
  guest_phone          String?                @db.VarChar(20)
  total_price          Decimal                @default(0.00) @db.Decimal(10, 2)
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  updated_at           DateTime               @default(now()) @db.Timestamp(0)
  purchase_order_code  String                 @db.VarChar(20)
  payment_status       String                 @default("UNPAID") @db.VarChar(20)
  user_id              Int?
  purchase_order_items purchase_order_items[]
  users                users?                 @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_purchase_orders_user")

  @@index([user_id], map: "fk_purchase_orders_user")
}

enum readers_gender {
  male
  female
  other
}

enum borrow_records_status {
  borrowing
  returned
  overdue
}

enum users_status {
  active
  inactive
}

enum users_role {
  admin
  librarian
  user
}
